# Paper risk guardrails
SONIC_PAPER_EQUITY_USD=10000
SONIC_RISK_PCT_PER_TRADE=0.5
SONIC_MAX_PORTFOLIO_RISK_PCT=2.0
SONIC_MAX_TRADES_PER_WEEK=5
SONIC_PENDING_EXPIRY_BARS=4

# Runtime and data
# Replit Database automatically provides DATABASE_URL. Locally this can stay
# empty so the application falls back to SONIC_DB_PATH.
DATABASE_URL=
SONIC_DB_PATH=results/paper_trading.db
SONIC_MONITOR_LOG_PATH=results/paper_monitor.log
SONIC_SCAN_LOCK_STALE_SECONDS=600
OKX_TIMEOUT_SECONDS=5

# Single-user authentication (required for backend health)
SONIC_ADMIN_USERNAME=admin
# Use at least 12 characters. Never commit the real value.
SONIC_ADMIN_PASSWORD=
# Generate a random value with at least 32 characters.
SONIC_SESSION_SECRET=
SONIC_SESSION_TTL_HOURS=12
# Keep false on local HTTP; set true when the public site uses HTTPS.
SONIC_COOKIE_SECURE=false
SONIC_LOGIN_MAX_ATTEMPTS=5
SONIC_LOGIN_WINDOW_SECONDS=300
# Replit Reserved VM: keep the M15 paper scanner running with the web app.
SONIC_RUN_MONITOR=true
SONIC_PORT=8000

# Realtime market stream
SONIC_REALTIME_MAX_INSTRUMENTS=50
SONIC_REALTIME_STALE_SECONDS=10
SONIC_REALTIME_BROADCAST_INTERVAL=0.25
